    top: -4px;
    font-size: 18px;
    color: rgb(46, 158, 62);
    padding: 0;
    margin: 0;
}

.fb-money-popup {
    position: absolute;
    translate: -50% -50%;
    color: var(--sun);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.6);
    -unity-text-align: middle-center;
    white-space: nowrap;
    padding: 0;
    margin: 0;
}

