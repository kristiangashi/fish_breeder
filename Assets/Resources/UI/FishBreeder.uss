/*
 * The game's look for UI Toolkit screens, matching UiTheme's IMGUI colours: deep lagoon windows
 * with a bright aqua rim, turquoise buttons, coral for the main action, sunny yellow titles and
 * warm sand text. Every UXML screen links this sheet, so UI Builder previews it too.
 *
 * Sizes are in UI units: the panel scales so the screen is always 900 units tall (see UiPanels).
 * Nothing here sets a fixed height on text; boxes grow to fit what's in them.
 */

:root {
    --abyss: rgb(5, 28, 43);
    --deep: rgb(8, 51, 74);
    --lagoon: rgb(10, 92, 112);
    --turquoise: rgb(26, 158, 163);
    --aqua: rgb(92, 230, 217);
    --coral: rgb(255, 117, 94);
    --sun: rgb(255, 212, 97);
    --sand: rgb(255, 245, 222);
    --muted: rgb(159, 180, 188);
    --faint: rgb(111, 143, 153);
    --danger: rgb(255, 176, 160);
    --leaf: rgb(143, 240, 160);

    font-size: 13px;
    color: var(--sand);
}

/* ------------------------------------------------------------ screens and windows */

/* Fills the whole screen. */
.fb-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Puts its child (a window) in the middle of the screen. */
.fb-center {
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.fb-dim {
    background-color: rgba(3, 15, 26, 0.55);
}

.fb-window {
    background-color: rgba(8, 64, 84, 0.97);
    border-width: 2px;
    border-color: var(--aqua);
    border-radius: 12px;
    padding: 12px 16px 14px 16px;
    max-width: 100%;
    /* Gets shorter on a short screen: its scrolling body gives up the room. */
    flex-shrink: 1;
    min-height: 0;
}

/* A window that comes from a template (Load Game, Settings): the template's own box spans the
   screen's width and lets the window inside shrink. */
.fb-page {
    align-self: stretch;
    align-items: center;
    flex-shrink: 1;
    min-height: 0;
}

.fb-window--narrow {
    width: 320px;
}

.fb-window--confirm {
    width: 400px;
}

.fb-window--medium {
    width: 520px;
}

.fb-window--wide {
    width: 640px;
}

/* The part of a window that scrolls when the screen is too short for all of it. */
.fb-window__body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 60px;
}

/* A row of buttons at the bottom of a window, kept on the right. */
.fb-window__footer {
    flex-direction: row;
    justify-content: flex-end;
    flex-shrink: 0;
    margin-top: 10px;
}

/* ------------------------------------------------------------ text */

/* Text and buttons never squash below their own height when a window gets short. */
.fb-title, .fb-heading, .fb-text, .fb-small, .fb-game-title, .fb-subtitle, .unity-button.fb-button {
    flex-shrink: 0;
}

.fb-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--sun);
    white-space: normal;
    margin-bottom: 4px;
    padding: 0;
}

.fb-heading {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--aqua);
    white-space: normal;
    margin: 10px 0 2px 0;
    padding: 0;
}

.fb-text {
    white-space: normal;
    padding: 0;
    margin: 2px 0;
}

.fb-small {
    font-size: 11px;
    color: var(--muted);
    white-space: normal;
    padding: 0;
    margin: 2px 0;
}

.fb-italic {
    -unity-font-style: italic;
}

.fb-warning {
    color: var(--danger);
}

/* ------------------------------------------------------------ buttons */

.unity-button.fb-button {
    background-color: rgb(24, 140, 148);
    border-width: 1px;
    border-color: rgb(115, 230, 217);
    border-radius: 8px;
    color: var(--sand);
    -unity-font-style: bold;
    font-size: 13px;
    padding: 4px 12px 5px 12px;
    margin: 3px 0;
    min-height: 34px;
    white-space: nowrap;
    transition-property: background-color, scale;
    transition-duration: 0.08s;
}

.unity-button.fb-button:hover {
    background-color: rgb(40, 172, 178);
    border-color: rgb(178, 255, 242);
    color: rgb(255, 255, 255);
}

.unity-button.fb-button:active {
    background-color: rgb(13, 97, 112);
    scale: 0.98 0.98;
}

.unity-button.fb-button:disabled {
    opacity: 0.4;
}

.unity-button.fb-button--primary {
    background-color: rgb(250, 120, 92);
    border-color: rgb(255, 204, 153);
}

.unity-button.fb-button--primary:hover {
    background-color: rgb(255, 150, 115);
    border-color: rgb(255, 230, 191);
}

.unity-button.fb-button--primary:active {
    background-color: rgb(204, 82, 66);
}

.unity-button.fb-button--primary:disabled {
    background-color: rgb(24, 140, 148);
    border-color: rgb(115, 230, 217);
}

.unity-button.fb-button--tall {
    min-height: 42px;
    font-size: 15px;
    margin: 4px 0;
}

/* Buttons side by side get a little room between them. */
.fb-window__footer > .unity-button.fb-button {
    margin-left: 6px;
}

/* A small square button holding a drawn arrow (see .fb-chevron). */
.unity-button.fb-button--icon {
    width: 34px;
    min-width: 34px;
    padding: 0;
    align-items: center;
    justify-content: center;
}

/* An arrow head drawn from two borders, so it never depends on the font. */
.fb-chevron {
    width: 9px;
    height: 9px;
    border-left-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--sand);
}

.fb-chevron--left {
    rotate: 45deg;
    margin-left: 4px;
}

.fb-chevron--right {
    rotate: -135deg;
    margin-right: 4px;
}

/* ------------------------------------------------------------ layout helpers */

.fb-row {
    flex-direction: row;
    align-items: center;
}

.fb-spacer {
    flex-grow: 1;
}

.fb-column {
    flex-direction: column;
    align-items: stretch;
}

/* ------------------------------------------------------------ cards and lists */

.fb-card {
    flex-direction: row;
    align-items: center;
    background-color: rgba(15, 77, 97, 0.95);
    border-width: 1px;
    border-color: rgb(64, 153, 158);
    border-radius: 8px;
    padding: 6px 8px;
    margin-bottom: 5px;
}

.fb-card:hover {
    border-color: var(--aqua);
}

.fb-card--selected {
    background-color: rgba(31, 128, 140, 0.97);
    border-width: 2px;
    border-color: var(--sun);
}

/* The text part of a card takes the room the buttons leave and wraps inside it. */
.fb-card__text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    padding: 0;
    margin: 0 8px 0 0;
}

.fb-card > .unity-button.fb-button {
    flex-shrink: 0;
    margin: 0 0 0 6px;
}

.fb-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.fb-scroll .unity-scroller--vertical {
    width: 10px;
    margin-left: 4px;
}

.fb-scroll .unity-scroller--vertical .unity-slider {
    width: 10px;
    min-width: 0;
    margin: 0;
}

.fb-scroll .unity-scroller--vertical .unity-base-slider__drag-container {
    width: 10px;
}

.fb-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 20, 31, 0.6);
    border-width: 0;
    border-radius: 5px;
}

.fb-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgb(92, 214, 207);
    border-width: 0;
    border-radius: 5px;
}

.fb-scroll .unity-scroller__low-button,
.fb-scroll .unity-scroller__high-button {
    display: none;
}

/* ------------------------------------------------------------ settings rows */

/* A setting: its name, then the value between back and forward arrows. */
.fb-choice {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.fb-choice__label {
    width: 150px;
    flex-shrink: 1;
    white-space: normal;
    padding: 0;
    margin: 0 6px 0 0;
}

.fb-choice__value {
    flex-grow: 1;
    min-width: 120px;
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 0 4px;
    margin: 0;
}

.fb-choice:disabled {
    opacity: 0.45;
}

/* ------------------------------------------------------------ main menu */

.fb-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.fb-bubble {
    position: absolute;
    border-radius: 50%;
    background-color: rgba(178, 242, 255, 0.18);
}

/* The title and whichever page is showing, down the middle of the screen. */
.fb-menu-column {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    padding: 9% 20px 40px 20px;
}

.fb-game-title {
    font-size: 52px;
    -unity-font-style: bold;
    color: var(--sun);
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 0;
    margin: 0;
}

.fb-subtitle {
    font-size: 15px;
    color: rgb(159, 230, 224);
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 0;
    margin: 0 0 26px 0;
}

.fb-menu-buttons {
    width: 320px;
    max-width: 100%;
}

.fb-footer {
    position: absolute;
    right: 12px;
    bottom: 6px;
    left: 12px;
    font-size: 11px;
    color: var(--faint);
    -unity-text-align: lower-right;
    white-space: normal;
}

/* ------------------------------------------------------------ game windows (Window.uxml) */

.fb-window__header {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    flex-shrink: 0;
}

.fb-window__title {
    margin-right: 14px;
}

/* Tabs and buttons a window puts beside its title. */
.fb-window__header-content {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    flex-grow: 1;
    flex-shrink: 1;
}

.unity-button.fb-window__close {
    margin-left: 8px;
}

.fb-window__content {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

/* A line under a window that shows what the pointer is over. */
.fb-tooltip-line {
    font-size: 11px;
    color: var(--muted);
    white-space: normal;
    min-height: 16px;
    padding: 0;
    margin: 4px 0 0 0;
    flex-shrink: 0;
}

/* ------------------------------------------------------------ pieces UiFrame makes */

.fb-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.unity-button.fb-tab {
    margin: 2px 4px 2px 0;
    min-height: 30px;
}

.unity-button.fb-tab--on {
    background-color: rgb(255, 199, 97);
    border-color: rgb(255, 235, 179);
    color: var(--abyss);
}

.unity-button.fb-tab--on:hover {
    background-color: rgb(255, 214, 128);
    color: var(--abyss);
}

.unity-button.fb-button--small {
    min-height: 26px;
    font-size: 12px;
    padding: 2px 8px 3px 8px;
}

.fb-card--column {
    flex-direction: column;
    align-items: stretch;
}

.fb-badge {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    border-radius: 4px;
    padding: 1px 6px 2px 6px;
    margin: 2px 4px 2px 0;
    white-space: nowrap;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.fb-bar {
    height: 8px;
    background-color: rgba(0, 13, 26, 0.6);
    border-radius: 4px;
    margin: 3px 0;
    flex-shrink: 0;
    overflow: hidden;
}

.fb-bar__fill {
    height: 100%;
    min-width: 6px;
    border-radius: 4px;
}

.fb-bar--thin {
    height: 6px;
}

.fb-image {
    flex-shrink: 0;
}

.unity-button.fb-image-button {
    flex-direction: column;
    align-items: center;
    padding: 4px;
}

.fb-image-button__text {
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: 11px;
    padding: 0;
    margin: 2px 0 0 0;
}

.fb-toggle {
    margin: 2px 0;
}

.fb-toggle .unity-toggle__checkmark {
    background-color: rgb(3, 26, 41);
    border-color: rgb(89, 204, 199);
    border-radius: 4px;
    -unity-background-image-tint-color: var(--leaf);
}

.fb-toggle .unity-toggle__text {
    color: var(--sand);
    white-space: normal;
    margin-left: 4px;
}

.fb-slider {
    flex-grow: 1;
    margin: 4px 0;
}

.fb-slider .unity-base-slider__tracker {
    background-color: rgba(0, 20, 31, 0.8);
    border-color: rgb(64, 153, 158);
    border-radius: 4px;
}

.fb-slider .unity-base-slider__dragger {
    background-color: var(--coral);
    border-width: 0;
    border-radius: 8px;
    width: 16px;
    height: 16px;
    margin-top: -7px;
}

.fb-field {
    margin: 2px 0;
}

.fb-field .unity-text-field__input {
    background-color: rgb(3, 26, 41);
    border-color: rgb(64, 153, 158);
    border-radius: 6px;
    color: var(--sand);
    padding: 3px 6px;
}

/* ------------------------------------------------------------ gauges (temperature, pH) */

.fb-gauge {
    height: 40px;
    margin: 2px 2px;
    flex-shrink: 0;
}

.fb-gauge__readout {
    position: absolute;
    top: 0;
    font-size: 11px;
    white-space: nowrap;
    padding: 0;
    margin: 0;
}

.fb-gauge__track {
    position: absolute;
    left: 0;
    right: 0;
    top: 15px;
    height: 10px;
    -unity-background-scale-mode: stretch-to-fill;
}

.fb-gauge__band {
    position: absolute;
    top: -3px;
    bottom: -3px;
    background-color: rgba(255, 255, 255, 0.25);
    border-width: 1px;
    border-color: rgb(255, 255, 255);
}

.fb-gauge__marker {
    position: absolute;
    top: -2px;
    bottom: -2px;
    width: 2px;
    margin-left: -1px;
    background-color: rgb(255, 255, 255);
}

.fb-gauge__ends {
    position: absolute;
    left: 0;
    right: 0;
    top: 26px;
    flex-direction: row;
}

.fb-gauge__end {
    font-size: 10px;
    color: rgb(191, 199, 209);
    padding: 0;
    margin: 0;
}

/* ------------------------------------------------------------ shared helpers for game windows */

.fb-grow {
    flex-grow: 1;
    flex-shrink: 1;
}

/* Something locked or out of reach: still readable, clearly not available. */
.fb-faded {
    opacity: 0.5;
}

.fb-text--small {
    font-size: 12px;
}

.fb-text--tiny {
    font-size: 10px;
}

/* Columns side by side that share the width equally (the perk trees, journal pages). */
.fb-columns {
    flex-direction: row;
    align-items: flex-start;
}

.fb-columns__column {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 8px;
}

.fb-tier {
    margin-top: 8px;
}

/* ------------------------------------------------------------ window sizes */

#perks-window {
    width: 1020px;
    height: 720px;
    max-height: 100%;
}

/* Two scrolling halves side by side (reputation, finances, aquarium). */
.fb-halves {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-top: 4px;
}

.fb-halves > .fb-scroll {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

.fb-half--left {
    margin-right: 16px;
}

/* A sunny section heading inside a window. */
.fb-section {
    -unity-font-style: bold;
    color: var(--sun);
    white-space: normal;
    padding: 0;
    margin: 10px 0 3px 0;
    flex-shrink: 0;
}

/* A line with words on the left and a number kept to the right. */
.fb-line {
    flex-direction: row;
    align-items: flex-start;
}

.fb-value {
    flex-shrink: 0;
    margin-left: 10px;
    -unity-text-align: upper-right;
    white-space: nowrap;
    padding: 0;
}

.fb-header-text {
    white-space: nowrap;
    padding: 0;
    margin: 0 12px 0 0;
    flex-shrink: 0;
}

/* Small step buttons (-, +, -5) and the number between them. */
.unity-button.fb-step {
    min-width: 30px;
    min-height: 28px;
    padding: 0 6px;
    margin: 2px 2px;
}

.fb-step-value {
    min-width: 74px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    padding: 0;
    margin: 0 2px;
}

/* The finances day-by-day chart: a bar up for profit, down for a loss. */
.fb-chart {
    flex-direction: row;
    height: 130px;
    background-color: rgba(0, 13, 26, 0.35);
    border-radius: 6px;
    padding: 4px;
    margin: 3px 0;
    flex-shrink: 0;
}

.fb-chart__slot {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
}

.fb-chart__half {
    flex-grow: 1;
    flex-basis: 0;
    width: 60%;
}

.fb-chart__up {
    justify-content: flex-end;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.25);
}

.fb-chart__bar {
    border-radius: 3px;
}

.fb-chart__day {
    font-size: 10px;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
    flex-shrink: 0;
}

#reputation-window, #finances-window, #aquarium-window {
    width: 980px;
    height: 700px;
    max-height: 100%;
}

.fb-spread {
    justify-content: space-between;
}

.fb-wrap {
    flex-wrap: wrap;
}

.fb-center-row {
    justify-content: center;
}

.unity-button.fb-button--gap {
    margin-right: 6px;
}

.fb-category {
    align-items: center;
}

.fb-category__name {
    width: 190px;
    flex-shrink: 1;
    margin-right: 6px;
}

.fb-chart__bar {
    width: 100%;
}

.fb-card--column > .unity-button.fb-button {
    margin: 4px 0 0 0;
}

/* ------------------------------------------------------------ research */

#research-window {
    width: 980px;
    height: 700px;
    max-height: 100%;
}

.unity-button.fb-button--wide {
    min-width: 96px;
    flex-shrink: 0;
}

.fb-button-stack {
    width: 96px;
    flex-shrink: 0;
}

.fb-budget-label {
    width: 170px;
    flex-shrink: 1;
}

.fb-step-value--narrow {
    min-width: 48px;
}

/* ------------------------------------------------------------ journal */

#journal-window {
    width: 900px;
    height: 640px;
    max-height: 100%;
}

.fb-journal-group {
    margin-top: 8px;
    align-items: center;
}

.fb-journal-grid {
    align-items: flex-start;
}

/* One fish in the index: its picture (or a dark silhouette), name and rarity. */
.unity-button.fb-journal-card {
    width: 120px;
    height: 150px;
    margin: 0 8px 8px 0;
    padding: 6px;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    background-color: rgba(15, 77, 97, 0.95);
    border-width: 1px;
    border-color: rgb(64, 153, 158);
    border-radius: 8px;
    white-space: normal;
}

.unity-button.fb-journal-card:hover {
    background-color: rgba(31, 128, 140, 0.97);
    border-color: var(--sun);
}

.unity-button.fb-journal-card--unknown:hover {
    background-color: rgba(15, 77, 97, 0.95);
    border-color: rgb(64, 153, 158);
}

.unity-button.fb-journal-card:disabled {
    opacity: 1;
}

.fb-journal-card__picture {
    height: 84px;
    border-radius: 8px;
    background-color: rgba(15, 115, 140, 0.7);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.fb-journal-card--unknown .fb-journal-card__picture {
    background-color: rgba(3, 20, 31, 0.8);
}

.fb-journal-card__photo {
    transition-property: translate;
    transition-duration: 0.15s;
}

.fb-journal-card:hover .fb-journal-card__photo {
    translate: 0 -3px;
}

.fb-journal-card__question {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 40px;
    color: var(--aqua);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.fb-badge.fb-journal-card__new {
    position: absolute;
    top: 3px;
    right: 3px;
    font-size: 10px;
    margin: 0;
}

.fb-journal-card__name {
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 0;
    margin: 4px 0 0 0;
    color: var(--sand);
}

.fb-journal-card__sub {
    font-size: 10px;
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 0;
    margin: 0;
}

.fb-journal-profile {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    align-items: stretch;
    margin-top: 4px;
}

.fb-journal-profile__left {
    width: 250px;
    flex-shrink: 0;
    margin-right: 12px;
}

.fb-journal-profile__picture {
    height: 170px;
    border-radius: 14px;
    background-color: rgba(15, 115, 140, 0.75);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-bottom: 4px;
}

.fb-journal-profile__facts {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

.fb-bullet {
    margin-left: 10px;
}

.fb-cross {
    margin-top: 6px;
}
