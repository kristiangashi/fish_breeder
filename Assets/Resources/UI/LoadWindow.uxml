<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="FishBreeder.uss" />
    <ui:VisualElement name="load-window" class="fb-window fb-window--wide">
        <ui:Label text="Load Game" class="fb-title" />
        <ui:Label name="load-warning" text="Loading leaves this game without saving it." class="fb-small" />
        <ui:Label name="no-saves" text="No saves yet." class="fb-text fb-italic" />
        <ui:ScrollView name="save-list" class="fb-scroll fb-window__body" />
        <ui:VisualElement class="fb-window__footer">
            <ui:Button name="back" text="Back (Esc)" class="fb-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
